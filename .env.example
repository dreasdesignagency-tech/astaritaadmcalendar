# Copie para .env (que o git ignora). Nunca coloque valores reais neste arquivo.

# --- Astarita Inbox: projeto Supabase PRÓPRIO (ref yappbzpayqejqpkfebho) ---
# Só a chave PUBLICÁVEL (anon). O app recusa chave service_role no navegador.
# Em produção o app já usa a URL e a chave publicável do projeto por padrão; defina só para apontar para outro projeto.
VITE_INBOX_SUPABASE_URL=
VITE_INBOX_SUPABASE_PUBLISHABLE_KEY=

# --- Servidor do Inbox (SÓ no servidor/hospedagem, nunca VITE_ e nunca no GitHub) ---
INBOX_SUPABASE_URL=
# A service_role ignora a RLS: só no servidor. Cria usuários/empresas e recebe webhooks.
INBOX_SUPABASE_SERVICE_ROLE_KEY=
# Criptografa o token e o App Secret do WhatsApp de cada empresa. 32 bytes em base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Guarde uma cópia em cofre de senhas: se for perdida, cada empresa precisa salvar o WhatsApp de novo.
INBOX_SECRETS_KEY=

# O WhatsApp (ID do número, token, App Secret) NÃO usa variáveis: cada empresa salva na tela de Configurações.

# Assistente de IA (opcional; sem isto o Inbox funciona e o assistente mostra "não ligado")
# INBOX_AI_PROVIDER: anthropic ou openai (openai serve também para provedores compatíveis, com INBOX_AI_BASE_URL)
INBOX_AI_PROVIDER=
INBOX_AI_API_KEY=
INBOX_AI_MODEL=

# --- Só para o script scripts/provision-inbox-users.mjs (uso excepcional) ---
ANDREAS_EMAIL=
JULINE_EMAIL=
INBOX_SITE_URL=

# --- Só para testes locais (aponta para servidores simulados). NÃO definir em produção. ---
# WHATSAPP_GRAPH_BASE_URL=
# INBOX_AI_BASE_URL=
