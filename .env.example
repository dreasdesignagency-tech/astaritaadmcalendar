# Copie para .env (que o git ignora). Nunca coloque valores reais neste arquivo.

# --- Calendário (já existente; o Lovable Cloud injeta). Não mexer para configurar o Inbox. ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Astarita Inbox: projeto Supabase PRÓPRIO (ref yappbzpayqejqpkfebho) ---
# Só a chave PUBLICÁVEL (anon). O app recusa chave service_role e recusa a URL do calendário.
# Sem estas duas, /inbox mostra "Inbox não configurado" e o calendário segue normal.
VITE_INBOX_SUPABASE_URL=
VITE_INBOX_SUPABASE_PUBLISHABLE_KEY=

# --- Somente no seu terminal, para scripts/provision-inbox-users.mjs. NUNCA no frontend, no GitHub ou em chat. ---
INBOX_SUPABASE_URL=
INBOX_SUPABASE_SERVICE_ROLE_KEY=
ANDREAS_EMAIL=
JULINE_EMAIL=
# Só para --invite: endereço onde o Inbox roda (o link do convite aponta para /inbox/definir-senha)
INBOX_SITE_URL=

# --- Servidor do Inbox (SÓ no servidor/hospedagem, nunca VITE_ e nunca no GitHub) ---
# Usadas pelas rotas /api/whatsapp/webhook e /api/inbox/*. A service_role ignora a RLS: só no servidor.
# (INBOX_SUPABASE_URL e INBOX_SUPABASE_SERVICE_ROLE_KEY acima também precisam estar no servidor.)

# WhatsApp Business Platform (Cloud API oficial)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Texto qualquer que você inventa; o mesmo valor vai no campo "Verify token" do webhook na Meta
WHATSAPP_VERIFY_TOKEN=
# "App secret" do app da Meta (valida a assinatura de cada webhook)
META_APP_SECRET=
# Exemplo de formato: v21.0 (use a versão que a Meta estiver recomendando)
WHATSAPP_API_VERSION=

# Assistente de IA (opcional; sem isto o Inbox funciona e o assistente mostra "não ligado")
# INBOX_AI_PROVIDER: anthropic ou openai (openai serve também para provedores compatíveis, com INBOX_AI_BASE_URL)
INBOX_AI_PROVIDER=
INBOX_AI_API_KEY=
INBOX_AI_MODEL=

# --- Só para testes locais (aponta para servidores simulados). NÃO definir em produção. ---
# WHATSAPP_GRAPH_BASE_URL=
# INBOX_AI_BASE_URL=
